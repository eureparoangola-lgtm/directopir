# Your domain (point its DNS A record at the server's IP). Caddy gets the HTTPS certificate automatically.
DOMAIN=live.example.com
PUBLIC_URL=https://live.example.com
# Hostname or IP the DJI remotes push RTMP to (usually the same domain)
RTMP_HOST=live.example.com
# Operator login for /admin. Use a long random password.
ADMIN_PASSWORD=change-me-to-something-long
# How long a viewer stays signed in after entering the passcode
VIEWER_SESSION_HOURS=12
